-- ====================== UTILITIES ======================
local Function = {}

function Function.TableToVector(t)
	return Vector3.new(t.x or t.X or 0, t.y or t.Y or 0, t.z or t.Z or 0)
end

function Function.TableToCFrame(t)
	if type(t) ~= "table" then return t end
	local pos = t.Position
	local rot = t.Rotation
	local cf = CFrame.new(pos.x, pos.y, pos.z)
	local angles = CFrame.fromEulerAnglesYXZ(math.rad(rot.x), math.rad(rot.y), math.rad(rot.z))
	return cf * angles
end

function Function.CFrameMultiply(cf, mult)
	return CFrame.new(
		cf.Position.X * mult.X,
		cf.Position.Y * mult.Y,
		cf.Position.Z * mult.Z
	) * cf.Rotation
end

function Function.Vector3Multiply(v, mult)
	return Vector3.new(v.X * mult.X, v.Y * mult.Y, v.Z * mult.Z)
end

function Function.MultiplyCalculate(base, default)
	return base.X / default.X, base.Y / default.Y, base.Z / default.Z
end

function Function.DarkenColor(color, amount)
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

function Function.StringToColor3(str)
	local r, g, b = str:match("([^,]+),([^,]+),([^,]+)")
	return Color3.fromRGB(math.round(tonumber(r) or 0), math.round(tonumber(g) or 0), math.round(tonumber(b) or 0))
end

function Function.FallenPartCheck(part)
	return part:IsA("BasePart") and part.Position.Y < workspace.FallenPartsDestroyHeight
end

