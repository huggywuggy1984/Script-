-- ====================== CORE SYSTEMS ======================
function Function.Weld(partConfig, character, extra, data)
	local name = partConfig.Name
	local parentPath = partConfig.Parent or { "Torso" }
	if not parentPath[1] then parentPath[1] = "Torso" end

	local morph = character:FindFirstChild("Morph")
	if not morph then return end

	local parent = morph
	for _, childName in ipairs(parentPath) do
		parent = parent:FindFirstChild(childName)
		if not parent then
			-- Deferred weld
			PlayerData[data].deferredWelds[parentPath[#parentPath]] = PlayerData[data].deferredWelds[parentPath[#parentPath]] or {}
			table.insert(PlayerData[data].deferredWelds[parentPath[#parentPath]], partConfig)
			return
		end
	end

	local bodyPart = character:FindFirstChild(parentPath[1]) or character.Torso
	local xMul, yMul, zMul = Function.MultiplyCalculate(bodyPart.Size, BodyPartSize[bodyPart.Name] or Vector3.new(2, 2, 1))

	local size = Function.TableToVector(partConfig.Size)
	local cframe = Function.TableToCFrame(partConfig.Joint.CFrame)
	local cframe1 = Function.TableToCFrame(partConfig.Joint.CFrame1)

	-- Scale support
	local scale = 1
	if partConfig.Scale then
		local s = PlayerData[data][partConfig.Scale] or 1
		if s >= 1 then
			scale = 1 + ((s - 1) / 5)
		else
			scale = 1 + ((s - 1) / 10)
		end
		if s == 1 then scale = 1 end

		local adjust = partConfig.AdjustScale
		if not adjust or table.find(adjust, "Size") then
			size = Function.Vector3Multiply(size, Vector3.new(scale, scale, scale))
		end
		if adjust and table.find(adjust, "CFrame") then
			cframe = Function.CFrameMultiply(cframe, Vector3.new(scale, scale, scale))
		end
		if not adjust or table.find(adjust, "CFrame1") then
			cframe1 = Function.CFrameMultiply(cframe1, Vector3.new(scale, scale, scale))
		end
	end

	local object
	if partConfig.Instance == "Mesh" then
		local ok, meshPart = pcall(function()
			return InsertService:CreateMeshPartAsync(partConfig.MeshId, Enum.CollisionFidelity.Box, Enum.RenderFidelity.Performance)
		end)
		if not ok or not meshPart then
			warn("[ClemonRC] Failed to create mesh:", name)
			return
		end
		object = meshPart
		if partConfig.TextureId then
			object.TextureID = partConfig.TextureId
		end
	else
		object = Instance.new("Part")
		object.Shape = partConfig.Shape or Enum.PartType.Block
		if partConfig.Mesh then
			local mesh = Instance.new("SpecialMesh")
			mesh.Name = name .. ".Mesh"
			mesh.MeshId = partConfig.Mesh.MeshId or ""
			mesh.MeshType = partConfig.Mesh.MeshType or Enum.MeshType.Brick
			mesh.TextureId = partConfig.Mesh.TextureId or ""
			local mScale = Function.TableToVector(partConfig.Mesh.Scale)
			if partConfig.Mesh.MeshType == Enum.MeshType.FileMesh then
				mScale = Function.Vector3Multiply(mScale, Vector3.new(xMul, yMul, zMul))
				if partConfig.Scale then
					mScale = Function.Vector3Multiply(mScale, Vector3.new(scale, scale, scale))
				end
			end
			mesh.Scale = mScale
			mesh.Parent = object
		end
	end

	-- Extra (decals etc.)
	if partConfig.Extra then
		for decalName, props in pairs(partConfig.Extra) do
			local decal = Instance.new("Decal")
			decal.Name = decalName
			decal.Transparency = props.Transparency or 0
			decal.ZIndex = props.ZIndex or 1
			decal.Face = props.Face or Enum.NormalId.Front
			decal.Texture = props.Texture or ""
			decal.Color3 = Function.DarkenColor(character.Torso.Color, 0.32)
			decal.Parent = object
		end
	end

	object.Name = name
	object.Transparency = partConfig.Transparency or 0
	object.Material = partConfig.Material or Enum.Material.SmoothPlastic
	object.CanCollide = false
	object.CanQuery = false
	object.CanTouch = false
	object.Massless = true
	object.Size = Function.Vector3Multiply(size, Vector3.new(xMul, yMul, zMul))
	object.Parent = parent

	if partConfig.Color and partConfig.Color ~= "Base" then
		object.Color = Function.DarkenColor(character.Torso.Color, PlayerData[data].colorConfig.Values["110, 110, 111"] or 0.32)
	else
		object.Color = character.Torso.Color
	end

	local weld = Instance.new("Motor6D")
	weld.Name = name .. " Weld"
	weld.Part0 = parent
	weld.Part1 = object
	weld.C0 = Function.CFrameMultiply(cframe, Vector3.new(xMul, yMul, zMul))
	weld.C1 = Function.CFrameMultiply(cframe1, Vector3.new(xMul, yMul, zMul))
	weld.Parent = object

	if partConfig.Physics and partConfig.Physics.PhysicsRotationOffset then
		object:SetAttribute("PhysicsRotationOffset", tostring(partConfig.Physics.PhysicsRotationOffset))
	end

	-- Run functions
	if partConfig.Function then
		if type(partConfig.Function) == "string" then
			if Function[partConfig.Function] then
				Function[partConfig.Function](object, character, extra, data)
			end
		elseif type(partConfig.Function) == "table" then
			for k, v in pairs(partConfig.Function) do
				if type(k) == "number" then
					if Function[v] then Function[v](object, character, extra, data) end
				else
					if Function[k] then Function[k](object, character, extra, data, v) end
				end
			end
		end
	end

	-- UV handling
	if extra.UVToggle then
		local lower = name:lower()
		if lower:find("nipple") or lower:find("butt") then
			object.Transparency = 1
		end
		if lower:find("skin") then
			object.Transparency = 0
		end
		if partConfig.UV == false then
			object.Transparency = 1
		end
		for decal in pairs(PlayerData[data].CurrentPartList.AreolaDecal) do
			if decal.Parent then decal:Destroy() end
		end
		PlayerData[data].CurrentPartList.AreolaDecal = {}
		if morph:FindFirstChild("Closed") then
			morph.Closed:Destroy()
		end
		Function.ApplyUV(object, character, extra, data)
	end

	PlayerData[data].CurrentPartList.Organ[name] = object
	PlayerData[data].CurrentPartList.RealtimeUpdateList.Mesh[object] = {
		Size = size,
		CFrame = weld.C0,
		CFrame1 = weld.C1,
		Base = bodyPart,
		Weld = weld,
	}

	-- Process deferred
	if PlayerData[data].deferredWelds[name] then
		for _, deferred in ipairs(PlayerData[data].deferredWelds[name]) do
			Function.Weld(deferred, character, extra, data)
		end
		PlayerData[data].deferredWelds[name] = nil
	end
end

function Function.ParseCharacter(character, data)
	-- R15 → R6 conversion helpers (kept from original)
	local R6_2_R15 = {
		Torso = { C0 = CFrame.new(0, -0.2, 0), C1 = CFrame.new(), Part0 = "UpperTorso", Part1 = "Torso" },
		["Left Leg"] = { C0 = CFrame.new(0, 0.201, 0), C1 = CFrame.new(), Part0 = "LeftLowerLeg", Part1 = "Left Leg" },
		["Right Leg"] = { C0 = CFrame.new(0, 0.201, 0), C1 = CFrame.new(), Part0 = "RightLowerLeg", Part1 = "Right Leg" },
		["Left Arm"] = { C0 = CFrame.new(0, 0.224, 0), C1 = CFrame.new(), Part0 = "LeftLowerArm", Part1 = "Left Arm" },
		["Right Arm"] = { C0 = CFrame.new(0, 0.224, 0), C1 = CFrame.new(), Part0 = "RightLowerArm", Part1 = "Right Arm" },
	}

	for _, v in ipairs(character:GetChildren()) do
		if v:IsA("BasePart") and v.Name ~= "Head" then
			v.Transparency = 1
		end
	end

	for name, props in pairs(R6Map) do
		if not character:FindFirstChild(name) then
			local part = Instance.new("Part")
			part.Name = name
			part.Size = props.Size
			part.Transparency = 0
			part.CanCollide = false
			part.Massless = true
			part.Color = character.Head.Color
			part.Parent = character

			local mesh = Instance.new("SpecialMesh")
			mesh.MeshId = "rbxassetid://12221758"
			if name ~= "Torso" then
				mesh.Scale = Vector3.new(0.5, 1, 1)
			end
			mesh.Parent = part
			table.insert(PlayerData[data].CurrentPartList.Organ, part)
		end
	end

	for name, props in pairs(R6_2_R15) do
		if character:FindFirstChild(props.Part0) and character:FindFirstChild(props.Part1) then
			local joint = Instance.new("Motor6D")
			joint.Name = name
			joint.C0 = props.C0
			joint.C1 = props.C1
			joint.Part0 = character[props.Part0]
			joint.Part1 = character[props.Part1]
			joint.Parent = character[props.Part0]
		end
	end
end

function Function.CharacterReset(character, data)
	if not character then return end
	local list = PlayerData[data].CurrentPartList

	for _, v in pairs(list.Organ) do
		if typeof(v) == "Instance" then v:Destroy() end
	end
	for _, v in pairs(list.Accessory) do
		if typeof(v) == "Instance" then v:Destroy() end
	end
	for _, v in pairs(list.Clothes) do
		if typeof(v) == "Instance" then v:Destroy() end
	end

	PlayerData[data].CurrentPartList = Function.PlayerDataDefault().CurrentPartList

	for _, v in ipairs(character:GetChildren()) do
		if v:IsA("BasePart") and table.find({"Torso", "Head", "Right Arm", "Right Leg", "Left Arm", "Left Leg"}, v.Name) then
			v.Transparency = 0
		end
		if v.Name == "Morph" then
			v:Destroy()
		end
	end

	-- Restore clothing
	if character.PrimaryPart then
		for _, v in ipairs(character.PrimaryPart:GetChildren()) do
			if v:IsA("Clothing") then
				v.Parent = character
			end
		end
	end
end

function Function.CharacterExecute(character, dataName)
	if not character then return end
	task.spawn(function()
		Function.PlayerDataAdd(dataName)
		Function.CharacterReset(character, dataName)

		local data = PlayerData[dataName]
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end

		local extra = {
			Shirt = character:FindFirstChildOfClass("Shirt"),
			Pants = character:FindFirstChildOfClass("Pants"),
			TShirt = character:FindFirstChildOfClass("ShirtGraphic"),
			UVToggle = data.UVToggle,
		}

		local selected = data.SelectedMorph
		if selected.NoUV then
			extra.UVToggle = false
		end

		if not extra.UVToggle then
			for _, v in pairs(extra) do
				if typeof(v) == "Instance" and v:IsA("Clothing") then
					v.Parent = character.PrimaryPart
				end
			end
		end

		if humanoid.RigType == Enum.HumanoidRigType.R15 then
			Function.ParseCharacter(character, dataName)
		end

		-- Create Morph container
		local morph = Instance.new("Model")
		morph.Name = "Morph"
		morph.Parent = character

		local function createContainer(name, size)
			local p = Instance.new("Part")
			p.Name = name
			p.Size = size or Vector3.new(2, 2, 1)
			p.Transparency = 1
			p.CanCollide = false
			p.Massless = true
			p.Parent = morph
			return p
		end

		local mTorso = createContainer("Torso", Vector3.new(2, 2, 1))
		local mRL = createContainer("Right Leg", Vector3.new(1, 2, 1))
		local mLL = createContainer("Left Leg", Vector3.new(1, 2, 1))
		local mRA = createContainer("Right Arm", Vector3.new(1, 2, 1))
		local mLA = createContainer("Left Arm", Vector3.new(1, 2, 1))

		table.insert(data.CurrentPartList.Organ, morph)

		for _, part in ipairs(morph:GetChildren()) do
			local weld = Instance.new("Weld")
			weld.Name = part.Name .. "_Weld"
			weld.Part0 = character:FindFirstChild(part.Name)
			weld.Part1 = part
			weld.Parent = part
			part.Color = character[part.Name].Color
			character[part.Name].Transparency = 0
		end

		-- Limbs
		if selected.Limbs then
			for _, obj in pairs(selected.Limbs) do
				Function.Weld(obj, character, extra, dataName)
				task.defer(function()
					local limb = character:FindFirstChild(obj.Parent[1])
					if limb then limb.Transparency = 1 end
				end)
			end
		end

		-- Main / Vaginas / Breasts / Butts
		local function processCategory(category, scaleKey)
			if not category then return end
			for _, obj in pairs(category) do
				if scaleKey then
					obj.Scale = scaleKey
				end
				Function.Weld(obj, character, extra, dataName)
			end
		end

		processCategory(selected.Main)
		if selected.Vaginas then
			for _, vaginaSet in pairs(selected.Vaginas) do
				local closed = createContainer("Closed")
				closed.Color = character.Torso.Color
				local w = Instance.new("Weld")
				w.Part0 = morph.Torso
				w.Part1 = closed
				w.Parent = closed
				for _, obj in pairs(vaginaSet) do
					Function.Weld(obj, character, extra, dataName)
				end
			end
		end
		processCategory(selected.Breasts, "BreastsScale")
		processCategory(selected.Butts, "ButtsScale")
	end)
end

-- ====================== UPDATE LOOPS ======================
local renderConnection
local physicsConnection

local function startLoops()
	if renderConnection then renderConnection:Disconnect() end
	if physicsConnection then physicsConnection:Disconnect() end

	renderConnection = RunService.RenderStepped:Connect(function()
		for playerName, dataList in pairs(PlayerData) do
			for part, prop in pairs(dataList.CurrentPartList.RealtimeUpdateList.Mesh) do
				if not part or not part.Parent then continue end
				local base = prop.Base
				if not base or not base.Parent then continue end

				local xMul, yMul, zMul = Function.MultiplyCalculate(base.Size, BodyPartSize[base.Name] or Vector3.new(2, 2, 1))
				local newC0 = CFrame.new(prop.CFrame.Position.X * xMul, prop.CFrame.Position.Y * yMul, prop.CFrame.Position.Z * zMul) * prop.CFrame.Rotation
				local newC1 = CFrame.new(prop.CFrame1.Position.X * xMul, prop.CFrame1.Position.Y * yMul, prop.CFrame1.Position.Z * zMul) * prop.CFrame1.Rotation

				if dataList.CurrentPartList.BodyPartPhysics[part] then
					dataList.CurrentPartList.BodyPartPhysics[part].CF = newC0
					dataList.CurrentPartList.BodyPartPhysics[part].CF1 = newC1
				else
					part.Size = Vector3.new(prop.Size.X * xMul, prop.Size.Y * yMul, prop.Size.Z * zMul)
					prop.Weld.C0 = newC0
					prop.Weld.C1 = newC1
				end
			end
		end
	end)

	physicsConnection = RunService.Stepped:Connect(function(_, dt)
		local camera = workspace.CurrentCamera
		for playerName, dataList in pairs(PlayerData) do
			for part, prop in pairs(dataList.CurrentPartList.BodyPartPhysics) do
				if Function.FallenPartCheck(part) then
					dataList.CurrentPartList.BodyPartPhysics[part] = nil
					continue
				end

				local base = prop.Base
				if not base or not base.Parent then continue end

				local _, onScreen = camera:WorldToScreenPoint(base.Position)
				if (camera.CFrame.Position - base.Position).Magnitude > CONFIG.MaxPhysicsDistance or not onScreen then
					continue
				end

				local spring = prop.Spring
				local originPos = prop.OriginCFrame.Position
				local currentPos = base.CFrame.Position
				local posDelta = originPos - currentPos

				local lookDelta = prop.OriginCFrame.LookVector - base.CFrame.LookVector
				local lookAxis = Vector3.new(lookDelta.X, lookDelta.Y, 0)

				spring:TimeSkip(dt)
				spring:Impulse(posDelta + lookAxis)

				local noise = Vector3.new(0.0015, 0.0015, 0.0015)
				if math.abs(spring.Velocity.X) <= noise.X and math.abs(spring.Velocity.Y) <= noise.Y and math.abs(spring.Velocity.Z) <= noise.Z then
					continue
				end

				local posList = { X = 0, Y = 0, Z = 0 }
				local rotList = { X = 0, Y = 0, Z = 0 }

				for from, to in pairs(prop.PositionOffset) do
					posList[from] = (prop.Position[to] * spring.Velocity[to]) * CONFIG.PositionPhysicsMultiply
				end
				for from, to in pairs(prop.RotationOffset) do
					rotList[from] = math.rad(prop.Rotation[to] * spring.Velocity[to] * (1 + math.random() * 0.01)) * CONFIG.RotationPhysicsMultiply
				end

				local scaleVec = Vector3.one
				if prop.Scale then
					scaleVec = Vector3.new(
						math.clamp(1 + rotList.X / 4, 0.8, 1.1),
						math.clamp(1 + rotList.Y / 4, 0.8, 1.1),
						math.clamp(1 + rotList.Z / 4, 0.8, 1.1)
					)
					part.Size = prop.Size * scaleVec
					local mesh = part:FindFirstChildOfClass("SpecialMesh")
					if mesh then
						mesh.Scale = prop.Size * scaleVec
					end
				end

				prop.Weld.C0 = prop.CF *
					Function.CFrameMultiply(CFrame.new(posList.X, posList.Y, posList.Z), scaleVec) *
					CFrame.Angles(rotList.X, rotList.Y, -rotList.Z)

				prop.OriginCFrame = base.CFrame
			end
		end
	end)
end

-- ====================== INPUT & COMMANDS ======================
local currentMorphIndex = 1
local morphKeys = {}

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	local data = PlayerData[LocalPlayer.Name]
	if not data then return end

	if input.KeyCode == Enum.KeyCode.C then
		data.UVToggle = not data.UVToggle
		Function.CharacterExecute(LocalPlayer.Character, LocalPlayer.Name)
		warn("[ClemonRC] UV Toggle:", data.UVToggle)
	elseif input.KeyCode == Enum.KeyCode.RightBracket then
		data.BreastsScale = data.BreastsScale + 0.1
		data.ButtsScale = data.ButtsScale + 0.1
		Function.CharacterExecute(LocalPlayer.Character, LocalPlayer.Name)
		warn("[ClemonRC] Scale set to", data.BreastsScale)
	elseif input.KeyCode == Enum.KeyCode.LeftBracket then
		data.BreastsScale = math.max(0.1, data.BreastsScale - 0.1)
		data.ButtsScale = math.max(0.1, data.ButtsScale - 0.1)
		Function.CharacterExecute(LocalPlayer.Character, LocalPlayer.Name)
		warn("[ClemonRC] Scale set to", data.BreastsScale)
	elseif input.KeyCode == Enum.KeyCode.B then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then
				Function.CharacterExecute(plr.Character, plr.Name)
			end
		end
	elseif input.KeyCode == Enum.KeyCode.P then
		if #morphKeys == 0 then
			for k in pairs(Function.PartListDefault()) do
				table.insert(morphKeys, k)
			end
		end
		currentMorphIndex = currentMorphIndex % #morphKeys + 1
		local morphName = morphKeys[currentMorphIndex]
		for _, plr in ipairs(Players:GetPlayers()) do
			task.spawn(function()
				PlayerData[plr.Name] = PlayerData[plr.Name] or Function.PlayerDataDefault()
				PlayerData[plr.Name].SelectedMorph = Function.PartListDefault()[morphName]
				if plr.Character then
					Function.CharacterExecute(plr.Character, plr.Name)
				end
				warn("[ClemonRC] Morph →", morphName)
			end)
		end
	elseif input.KeyCode == Enum.KeyCode.Equals then
		local mouse = LocalPlayer:GetMouse()
		local highlight = Instance.new("Highlight")
		highlight.FillTransparency = 0.7
		highlight.OutlineColor = Color3.new(1, 0.4, 0.7)
		local lastModel = nil
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local target = mouse.Target
			local model = target and target:FindFirstAncestorOfClass("Model")
			if model ~= lastModel then
				lastModel = model
				highlight.Parent = (model and model:FindFirstChildOfClass("Humanoid")) and model or nil
			end
		end)
		local click
		click = mouse.Button1Down:Connect(function()
			if highlight.Parent then
				Function.CharacterExecute(highlight.Parent, highlight.Parent.Name)
			end
			conn:Disconnect()
			click:Disconnect()
			highlight:Destroy()
		end)
	end
end)

TextChatService.MessageReceived:Connect(function(msg)
	local text = msg.Text
	local args = string.split(text, " ")
	if args[1] == "/execute" and args[2] then
		local target = workspace:FindFirstChild(args[2])
		if target then
			Function.CharacterExecute(target, args[2])
		end
	end
end)

